# Database
DATABASE_URI=postgresql://postgres:password@localhost:5432/svo_website

# Payload
PAYLOAD_SECRET=replace-with-a-long-random-secret-min-32-chars

# Migration ops (src/instrumentation.ts) — set one of these, boot the server once, then unset it.
# See DECISIONS.md "Known issues" for why this exists instead of `payload migrate`.
# PAYLOAD_MIGRATE_STATUS=1
# PAYLOAD_MIGRATE_ON_BOOT=1
# PAYLOAD_MIGRATE_CREATE_NAME=describe-the-schema-change
# PAYLOAD_MIGRATE_BASELINE=20260915_103709_initial_schema

# Server
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email (SMTP) — configure any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@svoe.at

# Board notifications — comma-separated list for multiple recipients
BOARD_NOTIFICATION_EMAIL=alexalexltesgo@gmail.com

# Contact form — where forwarded submissions are sent
CONTACT_FORWARD_EMAIL=info@svoe.at

# Media storage — on Vercel set BLOB_READ_WRITE_TOKEN (Vercel Blob store, region fra1/Frankfurt);
# with it unset, uploads use local disk (public/media), which does not work on Vercel.
# BLOB_READ_WRITE_TOKEN=…
# (S3 alternative, not built:)
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_ACCESS_KEY=
# MEDIA_S3_SECRET=
